#Python Code. This code puts the pivot of all selected meshes or groups on the center of the world.
import maya.cmds as cmds

def pivot_to_world_center():
    selection = cmds.ls(selection=True, long=True)

    if not selection:
        cmds.warning("Please select at least one object or group.")
        return

    for obj in selection:
        cmds.xform(
            obj,
            pivots=(0, 0, 0),
            worldSpace=True
        )

    print("Pivot moved to world origin (0, 0, 0).")


pivot_to_world_center()
